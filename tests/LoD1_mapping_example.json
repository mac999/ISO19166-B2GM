{
    "CRS": "EPSG:4326",
    "geometry": [
        {
            "input": "goyang_footprint_sample.geojson",
            "base_offset": [
                0.0,
                0.0,
                0.0
            ],
            "ground_storey": "GRO_FLO_CO",
            "underground_storey": "UND_FLO_CO",
            "storey_height": 3.0,
            "transform_utm": true,
            "height_scale": 1.0,
            "output": "output/lod1_buildings"
        }
    ],
    "style": [
        {
            "property": "BULD_NM",
            "match": "강선마을",
            "color": [
                0.85,
                0.35,
                0.3
            ]
        },
        {
            "property": "BULD_NM",
            "match": "문촌마을",
            "color": [
                0.35,
                0.65,
                0.85
            ]
        }
    ]
}