{
  "input": "../../duplex_apartment.ifc",
  "description": "LOD2 envelope: exterior walls, roof footprint and ground; the LOD1 block stays as the building solid. Placed at lon 127.0566696, lat 37.5069788 on Teheran-ro",
  "citygml_version": "2.0",
  "BIM_GIS_mapping.pipeline": [
    {
      "type": "PD",
      "name": "perspective: envelope",
      "output": "intermediate.ifc",
      "data_view": [
        {
          "class": "IfcBuilding",
          "filter": [
            {
              "name": ".*",
              "value": ".*",
              "type": ".*"
            }
          ]
        },
        {
          "class": "IfcWall.*",
          "filter": [
            {
              "name": "IsExternal",
              "value": "(?i)true",
              "type": ".*"
            }
          ]
        },
        {
          "class": "IfcSlab",
          "filter": [
            {
              "name": ".*",
              "value": ".*",
              "type": ".*"
            }
          ]
        },
        {
          "class": "IfcRoof",
          "filter": [
            {
              "name": ".*",
              "value": ".*",
              "type": ".*"
            }
          ]
        },
        {
          "class": "IfcFooting",
          "filter": [
            {
              "name": ".*",
              "value": ".*",
              "type": ".*"
            }
          ]
        }
      ],
      "logic_view": "",
      "style_view": [],
      "property_style": []
    },
    {
      "type": "EM",
      "name": "element mapping: envelope",
      "output": "city.gml",
      "rule": [
        {
          "source": "IfcBuilding",
          "destination": "CityModel.Building",
          "PSet_operation": "Append",
          "property_set": {
            "B2GM": {
              "source_standard": "ISO 19166 B2GM",
              "district": "Teheran-ro"
            }
          }
        },
        {
          "source": "IfcWall.*",
          "destination": "WallSurface"
        },
        {
          "source": "IfcSlab\\.ROOF",
          "destination": "RoofSurface"
        },
        {
          "source": "IfcRoof",
          "destination": "RoofSurface"
        },
        {
          "source": "IfcSlab\\.BASESLAB",
          "destination": "GroundSurface"
        },
        {
          "source": "IfcFooting",
          "destination": "GroundSurface"
        }
      ]
    },
    {
      "type": "LM",
      "name": "lod mapping: envelope",
      "output": "city_LoD_local.gml",
      "rule": [
        {
          "source": "IfcBuilding",
          "lod": "LOD1",
          "aggregate": "IfcWall.*",
          "operation": [
            {
              "op": "footprint"
            },
            {
              "op": "extrude",
              "args": {
                "height": {
                  "$extent": "z"
                }
              }
            }
          ]
        },
        {
          "source": "IfcSlab\\.ROOF",
          "lod": "LOD2",
          "operation": [
            {
              "op": "footprint"
            }
          ]
        },
        {
          "source": ".*",
          "lod": "LOD2"
        }
      ]
    },
    {
      "type": "CM",
      "name": "coordinate mapping: Korea 2000 central belt",
      "output": "city_LoD.gml",
      "rule": [
        {
          "source": "EPSG:4326",
          "destination": "EPSG:5186"
        },
        {
          "origin": {
            "lon": 127.0566696,
            "lat": 37.5069788,
            "elevation": 30.0
          }
        },
        {
          "rotation": -68.69
        }
      ]
    }
  ]
}